# Neon PostgreSQL asyncpg connection string (no channel_binding or sslmode parameters)
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_sample_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# Dedicated Test Database URL (strictly for automated tests, never run against DATABASE_URL)
TEST_DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_sample_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb_test?ssl=require

# OpenRouteService API (HeiGIT)
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_BASE_URL=https://api.heigit.org

# Routing Fallback & Cache Settings
ROUTING_FALLBACK_ENABLED=false
CACHE_TTL_SECONDS=300

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding (for scripts/seed_admin.py)
ADMIN_EMAIL=admin@smartroute.ai
ADMIN_PASSWORD=change_this_admin_password_min_8_chars

# CORS Allowed Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Incident Lifecycle & Voting Settings
INCIDENT_TTL_MINUTES=45
INCIDENT_VOTE_RADIUS_M=1000
INCIDENT_DEDUPE_RADIUS_M=100
VALIDATION_THRESHOLD=3
REJECTION_THRESHOLD=3
MAX_REPORTS_PER_10_MIN=3
MAX_VOTES_PER_HOUR=30
CIVILIAN_CONFIRM_WEIGHT=1.0
AMBULANCE_CONFIRM_WEIGHT=2.0
ADMIN_CONFIRM_WEIGHT=3.0

# Realtime WebSocket Settings
WS_MAX_CONNECTIONS_PER_USER=3
WS_AUTH_TIMEOUT_S=5
MAX_SUBSCRIBE_RADIUS_M=20000

# Hospital & Overpass Settings
OVERPASS_URL=https://overpass-api.de/api/interpreter
HOSPITAL_SEARCH_RADIUS_M=15000
HOSPITAL_PREFILTER_COUNT=6
HOSPITAL_ROUTE_COUNT=3

# Ambulance Live Tracking & Proximity Warning
AMBULANCE_LOCATION_MIN_INTERVAL_S=2
AMBULANCE_LOCATION_STALE_S=30
AMBULANCE_DB_FLUSH_S=15
AMBULANCE_WARN_RADIUS_M=1500
CIVILIAN_WARN_MIN_INTERVAL_S=5

# Dispatch Settings
DISPATCH_CANDIDATE_RADIUS_M=10000
DISPATCH_CANDIDATE_ROUTE_COUNT=3
DISPATCH_OFFER_TIMEOUT_S=60
DISPATCH_MAX_OFFERS_PER_INCIDENT=5
EMERGENCY_NUMBER=112
